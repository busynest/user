{
  "name": "pwa-auth",
  "type": "module",
  "author": {
    "name": "Jacek Markiewicz",
    "url": "https://www.jackspublishing.com",
    "email": "jack.solutionbox@gmail.com"
  },
  "version": "3.5.0",
  "description": "Five elements: user-icon, user-drawer, user-login, user-settings, and email-reset. pwa- events, a small API, and --pwa_ theme variables.",
  "homepage": "https://pwa-authentic.firebaseapp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/busynest/user"
  },
  "bugs": {
    "url": "https://github.com/busynest/user/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/busynest"
  },
  "keywords": [
    "login",
    "pwa",
    "pwa-auth",
    "auth",
    "firebase",
    "user-icon",
    "user-drawer",
    "user-login",
    "user-settings",
    "email-reset",
    "web components"
  ],
  "main": "./base/export/pwa-auth.js",
  "types": "./base/export/pwa-auth.d.ts",
  "exports": {
    ".": {
      "types": "./base/export/pwa-auth.d.ts",
      "import": "./base/export/pwa-auth.js",
      "default": "./base/export/pwa-auth.js"
    },
    "./production": {
      "types": "./base/export/pwa-auth.d.ts",
      "import": "./source/pwa-auth.js",
      "default": "./source/pwa-auth.js"
    }
  },
  "sideEffects": true,
  "files": [
    "base",
    "source/pwa-auth.js",
    "source/pwa-styles.css",
    "source/empty.jpg",
    "README.md",
    "license",
    "LICENSES.txt"
  ],
  "typesVersions": {
    "*": {
      "production": [
        "./base/export/pwa-auth.d.ts"
      ]
    }
  },
  "license": "SEE LICENSES.txt",
  "scripts": {
    "server": "web-dev-server --node-resolve --watch --open",
    "demo": "web-dev-server --node-resolve --watch --open --app-index demonstration/index.html",
    "website": "web-dev-server --node-resolve --watch --open --app-index website/index.html",
    "rollup": "rollup -c rollup.config.js",
    "build": "tsc --project tsconfig.production.json && node typescript/keep-deprecated.js",
    "prepublishOnly": "npm run build && npm run rollup",
    "test": "vitest run",
    "test:emulator": "npx --yes firebase-tools@14.24.0 emulators:exec --only auth,firestore,storage --project pwa-authentic \"node typescript/emulator/run.mjs\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "pwa-helpers": "^0.9.1",
    "redux": "^5.0.1"
  },
  "peerDependencies": {
    "firebase": "^12.0.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-env": "^7.28.5",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.1.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.3",
    "@web/dev-server": "^0.4.6",
    "@web/rollup-plugin-copy": "^0.5.1",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "firebase": "12.19.0",
    "lit": "3.3.3",
    "happy-dom": "^21.0.4",
    "rollup": "^4.54.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-html-literals": "^2.0.1",
    "rollup-plugin-license": "^3.6.0",
    "rollup-plugin-summary": "^3.0.1",
    "tslib": "^2.8.1",
    "vitest": "^5.0.5"
  }
}
